{
  "functions": {
    "source": "functions"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "irfanacademy",
          "configurations": {
            "android": "1:843262522577:android:37af2a3518377a214181f0",
            "ios": "1:843262522577:ios:3614e9f89017ac204181f0",
            "web": "1:843262522577:web:86a06468d4e95d514181f0"
          }
        }
      },
      "android": {
        "default": {
          "projectId": "irfanacademy",
          "appId": "1:843262522577:android:37af2a3518377a214181f0",
          "fileOutput": "android/app/google-services.json"
        }
      }
    }
  }
